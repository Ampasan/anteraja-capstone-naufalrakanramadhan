APP_NAME=Anteraja
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=https://anteraja-dispatch.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=10

LOG_CHANNEL=stack
LOG_LEVEL=debug

# === DATABASE SUPABASE ===
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=prefer
DB_PERSISTENT=false

# === SESSION & CACHE ===
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# === REALTIME BROADCASTING (Laravel Reverb) ===
BROADCAST_CONNECTION=reverb
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# === REDIS ===
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CLIENT=predis
REDIS_DB=0
REDIS_CACHE_DB=1

# === CLOUDINARY ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# === SANCTUM ===
SANCTUM_STATEFUL_DOMAINS=anteraja-dispatch.vercel.app

# === CORS ===
CORS_ALLOWED_ORIGINS=https://anteraja-dispatch.vercel.app

# === PRODUKSI ===
SEED_ON_START=false
COURIER_SIMULATION=true
APP_OPERATIONAL_NOW=