                            "key": "token",
                            "value": "{{token}}"
                        }
                    ]
                },
                "method": "POST",
                "body": {
                    "mode": "formdata",
                    "formdata": [
                        {
                            "key": "photo",
                            "type": "file",
                            "src": [],
                            "description": "File gambar jpg/png max 5MB"
                        },
                        {
                            "key": "caption",
                            "value": "Foto bukti kondisi paket",
                            "type": "text"
                        }
                    ]
                },
                "url": {
                    "raw": "{{base_url}}/incidents/{{incident_id}}/upload-evidence",
                    "host": [
