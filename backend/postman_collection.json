                        "upload-evidence"
                    ]
                }
            }
        },
        {
            "name": "Export Incident Daily Report (CSV)",
            "request": {
                "method": "GET",
                "description": "Unduh laporan insiden harian (CSV). date opsional, default hari ini. Format kolom identik dengan output `php artisan report:daily-incidents`.",
                "header": [
                    {
                        "key": "Accept",
                        "value": "application/json"
                    },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{token}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/incidents/export?date=2026-10-01",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "incidents",
                        "export"
                    ],
                    "query": [
                        {
                            "key": "date",
                            "value": "2026-10-01",
                            "description": "Format Y-m-d, default hari ini"
