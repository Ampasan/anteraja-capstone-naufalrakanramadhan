                    "raw": "{\n  \"order_number\": \"100024000009\",\n  \"courier_id\": \"{{courier_id}}\",\n  \"incident_category\": \"Anomali Suhu\",\n  \"title\": \"Pendingin Tidak Stabil\",\n  \"description\": \"Suhu box pendingin melonjak\"\n}",
                    "options": {
