# ─── Hub Aktif ───────────────────────────────────────────────────────────────
VITE_ACTIVE_HUB_CODE=HUB-CODE-HERE
VITE_ACTIVE_HUB_NAME=YOUR_HUB_NAME
VITE_ACTIVE_HUB_LAT=-0.0000000
VITE_ACTIVE_HUB_LNG=000.0000000
VITE_ACTIVE_HUB_MAPS_URL=https://maps.app.goo.gl/your_maps_link

# ─── Cloudinary (upload foto bukti insiden) ──────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_FOLDER=foto_bukti
VITE_CLOUDINARY_API_KEY=your_api_key

# ─── Backend API URL (endpoint Laravel) ─────────────────────────────────────
VITE_API_URL=http://localhost:8000/api

# ─── Realtime WebSocket (Laravel Reverb) ─────────────────────────────────────
VITE_REVERB_APP_KEY=your_app_key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http